# Public URL where the site will be deployed (no trailing slash).
# Used for canonical URL, Open Graph tags, sitemap.xml and robots.txt.
VITE_SITE_URL=

# Contact form endpoint. Any service that accepts a JSON POST works
# (e.g. Formspree: https://formspree.io/f/<your-id>, Getform, Basin, or your own backend).
# Leave empty to fall back to opening the visitor's e-mail client.
VITE_FORM_ENDPOINT=
